#!/usr/bin/env bash
# Enable or withdraw auto-merge on one pull request through `gh`, and nothing else.
#
#   gh-agent-pr-merge pr merge <number> --auto --merge --match-head-commit <40-hex sha> --repo <owner/name>
#   gh-agent-pr-merge pr merge <number> --disable-auto --repo <owner/name>
#
# The system forbids the agent to merge its own work with a bare `gh` call. This CLI is the only
# path it has: each accepted form is replayed as the corresponding `gh pr merge` call, and the head
# commit is passed through unchanged, so GitHub itself voids the auto-merge if the branch moves.
# It never approves a pull request, never merges directly and never passes --admin, so it cannot
# bypass branch protection; a person approves the test results before it is called. Every argument
# is checked before any network call.
#
# `gh` is taken from GH_AGENT_PR_MERGE_GH when set, which the tests use, otherwise from PATH; the
# CLI adds no credentials of its own and leaves GH_CONFIG_DIR and PATH alone. `exec` hands `gh`
# this process, so its exit code and both streams reach the caller unchanged.
#
# Exit: 0 when `gh` succeeds; `gh`'s own status when it fails; 2 for a refused argument; 1 when
# `gh` cannot be found.

set -u

usage() {
  cat <<'EOF'
gh-agent-pr-merge: enable or withdraw auto-merge on one pull request, and nothing else.

Usage:
  gh-agent-pr-merge pr merge <number> --auto --merge --match-head-commit <40-hex sha> --repo <owner/name>
  gh-agent-pr-merge pr merge <number> --disable-auto --repo <owner/name>

The enable form runs:  gh pr merge <number> --auto --merge --match-head-commit <sha> --repo <repo>
The disable form runs: gh pr merge <number> --disable-auto --repo <repo>

The head commit is forwarded unchanged, so GitHub voids the auto-merge if the branch moves.

Refused before any network call: any subcommand other than `pr merge`, a <number> that is not a
positive integer, a missing or malformed --repo, the enable form without --merge and a 40-hex
--match-head-commit (or the disable form with either of them), --admin, and unknown options.

This CLI never approves a pull request and never bypasses branch protection. A person approves the
test results first; only then may an agent call it.
EOF
}

refuse() {
  printf 'gh-agent-pr-merge: %s\n' "$1" >&2
  exit 2
}

fail() {
  printf 'gh-agent-pr-merge: %s\n' "$1" >&2
  exit 1
}

for word in "$@"; do
  case $word in
    -h | --help) usage; exit 0 ;;
    --admin | --admin=*) refuse '--admin is refused; this CLI never bypasses branch protection' ;;
  esac
done

if [ "$#" -lt 2 ] || [ "$1" != pr ] || [ "$2" != merge ]; then
  refuse 'the only subcommand is `pr merge`; run --help for the contract'
fi
shift 2

number= repo= sha=
auto=0 merge=0 disable=0
while [ "$#" -gt 0 ]; do
  case $1 in
    --auto) auto=1; shift ;;
    --merge) merge=1; shift ;;
    --disable-auto) disable=1; shift ;;
    --repo)
      [ "$#" -ge 2 ] || refuse '--repo needs a value'
      repo=$2; shift 2 ;;
    --repo=*)
      repo=${1#--repo=}; shift ;;
    --match-head-commit)
      [ "$#" -ge 2 ] || refuse '--match-head-commit needs a value'
      sha=$2; shift 2 ;;
    --match-head-commit=*)
      sha=${1#--match-head-commit=}; shift ;;
    -*) refuse "unknown option $1; run --help for the contract" ;;
    *)
      [ -z "$number" ] || refuse "unexpected argument $1; run --help for the contract"
      number=$1; shift ;;
  esac
done

[ -n "$number" ] || refuse '<number> must be a positive integer'
[[ $number =~ ^[0-9]*[1-9][0-9]*$ ]] || refuse '<number> must be a positive integer'
[ -n "$repo" ] || refuse '--repo <owner/name> is required'
[[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || refuse '--repo must be owner/name'

if [ "$auto" = 1 ] && [ "$disable" = 1 ]; then
  refuse '--auto and --disable-auto are mutually exclusive'
fi
if [ "$auto" = 1 ]; then
  [ "$merge" = 1 ] || refuse '--auto requires --merge and --match-head-commit <40-hex sha>'
  [ -n "$sha" ] || refuse '--auto requires --merge and --match-head-commit <40-hex sha>'
  [[ $sha =~ ^[0-9a-fA-F]{40}$ ]] || refuse '--match-head-commit must be a 40-hex commit SHA'
elif [ "$disable" = 1 ]; then
  if [ "$merge" = 1 ] || [ -n "$sha" ]; then
    refuse '--disable-auto takes only --repo; --merge and --match-head-commit belong to the enable form'
  fi
else
  refuse 'choose either --auto (enable) or --disable-auto (disable)'
fi

if [ -n "${GH_AGENT_PR_MERGE_GH:-}" ]; then
  gh=$GH_AGENT_PR_MERGE_GH
else
  gh=$(command -v gh 2>/dev/null) || gh=
fi
[ -n "$gh" ] || fail 'gh not found on PATH; install the GitHub CLI or set GH_AGENT_PR_MERGE_GH to it'
case $gh in
  */*) [ -x "$gh" ] || fail "gh at $gh is not executable" ;;
  *) gh=$(command -v "$gh" 2>/dev/null) || fail "gh not found: $gh" ;;
esac

if [ "$auto" = 1 ]; then
  exec "$gh" pr merge "$number" --auto --merge --match-head-commit "$sha" --repo "$repo"
fi
exec "$gh" pr merge "$number" --disable-auto --repo "$repo"
